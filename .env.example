# Supabase — create a new project, then: `supabase link --project-ref …` and `supabase db push`
# RLS is enabled on tables; this app uses the service role from server routes only (no anon data reads yet).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Stripe
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# Inquiries
ADMIN_ALLOWED_EMAILS=ritualmakerny@gmail.com
ADMIN_OWNER_ACCESS_CODE=
# NextAuth (generate with `openssl rand -base64 32`)
AUTH_SECRET=

# Site
NEXT_PUBLIC_SITE_URL=https://ritualmakerny.com

# Instagram — live feed on the home page (server only; not exposed to the browser)
# Long‑lived access token with instagram_basic (or equivalent) for the account.
INSTAGRAM_ACCESS_TOKEN=
# Instagram Business / creator user id (Meta Business Suite → Instagram account details).
# Required for: https://graph.facebook.com/v21.0/{id}/media
# Omit to try https://graph.instagram.com/me/media (only works with some token types).
INSTAGRAM_USER_ID=
