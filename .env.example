# Sanity (project shared with alenephotographs.com, separate dataset)
NEXT_PUBLIC_SANITY_PROJECT_ID=qjcf272e
NEXT_PUBLIC_SANITY_DATASET=ritualmaker
# Optional: set to 1 only for CI that runs `next build` without real Sanity env (site will have no CMS data).
ALLOW_BUILD_WITHOUT_SANITY=
NEXT_PUBLIC_SANITY_API_VERSION=2024-11-01
SANITY_API_READ_TOKEN=
SANITY_API_WRITE_TOKEN=
# Optional: project + dataset for writes. Must match SANITY_API_WRITE_TOKEN. Defaults to NEXT_PUBLIC_SANITY_*.
SANITY_API_PROJECT_ID=
SANITY_API_DATASET=

# Stripe
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# Inquiries
ADMIN_ALLOWED_EMAILS=ritualmakerny@gmail.com
ADMIN_OWNER_ACCESS_CODE=
AUTH_SECRET=

# Site
NEXT_PUBLIC_SITE_URL=https://ritualmakerny.com

# Shippo (USPS live rates for shipped flower products — server only)
# Create a token at https://apps.goshippo.com/api-keys/
SHIPPO_API_TOKEN=
# Optional: restrict rating to your USPS carrier account (GET /carrier_accounts in Shippo)
SHIPPO_USPS_CARRIER_ACCOUNT_ID=
# Ship-from address (required for quotes)
SHIPPO_FROM_NAME=Ritualmaker
SHIPPO_FROM_STREET1=
SHIPPO_FROM_STREET2=
SHIPPO_FROM_CITY=
SHIPPO_FROM_STATE=
SHIPPO_FROM_ZIP=
SHIPPO_FROM_COUNTRY=US
SHIPPO_FROM_PHONE=
SHIPPO_FROM_EMAIL=
# Default parcel for oil bottle (override as needed)
SHIPPO_PARCEL_LENGTH_IN=8
SHIPPO_PARCEL_WIDTH_IN=6
SHIPPO_PARCEL_HEIGHT_IN=4
SHIPPO_PARCEL_WEIGHT_LB=1

# Instagram — live feed on the home page (server only; not exposed to the browser)
# Long‑lived access token with instagram_basic (or equivalent) for the account.
INSTAGRAM_ACCESS_TOKEN=
# Instagram Business / creator user id (Meta Business Suite → Instagram account details).
# Required for: https://graph.facebook.com/v21.0/{id}/media
# Omit to try https://graph.instagram.com/me/media (only works with some token types).
INSTAGRAM_USER_ID=
